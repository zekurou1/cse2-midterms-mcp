# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MCP_PORT=8765
# Set only the hostname supplied by your HTTPS tunnel, without https:// or /mcp.
PUBLIC_HOST=
# Optional Claude Web OAuth. scripts/enable_claude.py sets these for the current tunnel.
OAUTH_ISSUER_URL=
OAUTH_PASSWORD=
# Temporary public test mode: 1 skips auth and exposes ONLY workspace/claude-test/.
# Anyone with the tunnel URL can modify this synthetic folder. Restore 0 after testing.
MCP_DEMO_NO_AUTH=0
